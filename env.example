# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_db

# Next Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Domains allowed to access the application (comma-separated list)
# Remove ports in production. Use localhost for local dev.
ALLOWED_DOMAINS="localhost,internal.myapp.local,external.mywebsite.com"

# Seeding
# Admin password for the initial seed (username: admin). Required for seeding.
ADMIN_PASSWORD="your_secure_admin_password_here"

# Security & Programmatic Access
# Optional shared secret for EXTERNAL cron webhook calls (/api/cron/*).
# Built-in in-process scheduler runs automatically without requiring CRON_SECRET,
# and ADMIN users can trigger syncs from Settings > Master Data.
CRON_SECRET="generate_with_openssl_rand_hex_32"
# API key for MCP server or external automation (/api/*)
MCP_API_KEY="generate_with_openssl_rand_hex_32"

# Market Data Caching & Sync Tuning (Optional)
# MARKET_HOURS_AWARE="true"            # Use shorter TTL during 09:30-16:15 ET Mon-Fri, longer overnight/weekends
# PRICE_CACHE_TTL_MS=120000            # 2m regular market quote freshness
# OFF_HOURS_PRICE_CACHE_TTL_MS=1800000 # 30m off-hours quote freshness
# METADATA_CACHE_TTL_MS=43200000       # 12h sector/country/dividend metadata freshness
# HISTORY_CACHE_TTL_MS=86400000        # 24h daily OHLCV history freshness
# MANUAL_REFRESH_COOLDOWN_MS=15000     # 15s cooldown between coalesced manual portfolio refreshes
# INCREMENTAL_SYNC_BATCH_SIZE=20       # Symbols per Yahoo Finance quote batch (1-50)

# Note: DATABASE_URL is constructed automatically in docker-compose.yml
# but for local development without docker-compose, use:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db"
