# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_db

# Next Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Domains allowed to access the application (comma-separated list)
# Remove ports in production. Use localhost for local dev.
ALLOWED_DOMAINS="localhost,internal.myapp.local,external.mywebsite.com"

# Seeding
# Admin password for the initial seed (username: admin). Required for seeding.
ADMIN_PASSWORD="your_secure_admin_password_here"

# Security & Programmatic Access
# Shared secret for cron endpoints (/api/cron/*)
CRON_SECRET="generate_with_openssl_rand_hex_32"
# API key for MCP server or external automation (/api/*)
MCP_API_KEY="generate_with_openssl_rand_hex_32"

# Note: DATABASE_URL is constructed automatically in docker-compose.yml
# but for local development without docker-compose, use:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db"

